{
  "name": "virologia-em-jogo",
  "version": "2.0.0",
  "private": true,
  "description": "Virologia em Jogo: palavras-cruzadas, caça-palavras e biblioteca de estudos de Virologia Veterinária",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "webpack serve --mode development",
    "dev": "node scripts/dev.mjs",
    "build": "webpack --mode production",
    "server": "tsx watch server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --outfile=build/server.cjs",
    "start:server": "node build/server.cjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server tests",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "game",
    "crossword",
    "word-search",
    "veterinary",
    "virology",
    "educational"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.2",
    "@types/node": "^22.20.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.5.0",
    "mini-css-extract-plugin": "^2.7.6",
    "sass": "^1.106.1",
    "sass-loader": "^16.0.8",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.72.0",
    "webpack": "^5.86.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "qrcode-generator": "^2.0.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}
